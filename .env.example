# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API. When these are set, the app uses real Supabase Auth
# and the Postgres backend; when empty, it runs in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser). Used for privileged operations
# such as county-capped boost slot enforcement and analytics pipelines.
SUPABASE_SERVICE_ROLE_KEY=

# Product analytics sink (Story OS).
# noop | console | remote (POST /api/analytics → product_analytics_events)
# Default in code: remote (soft-fails if migration 0029 not applied).
# NEXT_PUBLIC_ANALYTICS_SINK=remote
NEXT_PUBLIC_ANALYTICS_SINK=

# Research 3D engine (optional). Public token only (pk.). Restrict it to
# https://storyhome-1-eqmg.vercel.app in the Mapbox account. Tiles stay ours —
# do not point the style at mapbox:// streets, satellite, or terrain.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.

# NEVER set this on production / storyhome-1-eqmg. Local test login only.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# Server-only Launch-7 object storage (never NEXT_PUBLIC_).
# LAUNCH7_R2_ACCOUNT_ID=
# LAUNCH7_R2_BUCKET=
# LAUNCH7_R2_ACCESS_KEY_ID=
# LAUNCH7_R2_SECRET_ACCESS_KEY=
